<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Must stay untrimmed: the user's compiled component is resolved against the
         full BCL + ASP.NET Core assemblies at runtime, so nothing may be linked away. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- BCL + ASP.NET Core reference assemblies used by the compiler. Generated by
       scripts/prepare-refs.ps1 and embedded so they are available without a file system. -->
  <ItemGroup>
    <EmbeddedResource Include="refs\*.dll" LogicalName="lib.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
