<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Must stay untrimmed: the user's compiled component is resolved against the
         full BCL + ASP.NET Core assemblies at runtime, so nothing may be linked away. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <!-- Roslyn 5.9 aborts the WebAssembly runtime; 4.14 is the generation that runs. The Razor
         compiler asks for 5.9 but binds against this by simple name on Mono, which is fine. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- The Razor compiler ships as a Roslyn source generator inside the SDK (there is no released
       standalone package). It is embedded rather than referenced: an assembly reference makes
       MSBuild resolve the compiler's own Roslyn 5.9 dependency from the SDK and publish it, which
       aborts the runtime. Loaded from bytes at run time it uses the Roslyn already in the app. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildSDKsPath)\Microsoft.NET.Sdk.Razor\source-generators\Microsoft.CodeAnalysis.Razor.Compiler.dll"
                      LogicalName="razor.Microsoft.CodeAnalysis.Razor.Compiler.dll" />
    <EmbeddedResource Include="$(MSBuildSDKsPath)\Microsoft.NET.Sdk.Razor\source-generators\Microsoft.AspNetCore.Razor.Utilities.Shared.dll"
                      LogicalName="razor.Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
  </ItemGroup>

  <!-- BCL + ASP.NET Core reference assemblies used by the compiler. Generated by
       scripts/prepare-refs.ps1 and embedded so they are available without a file system. -->
  <ItemGroup>
    <EmbeddedResource Include="refs\*.dll" LogicalName="lib.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
