<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Must stay untrimmed: the user's compiled component is resolved against the
         full BCL + ASP.NET Core assemblies at runtime, so nothing may be linked away. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <!-- Roslyn 5.9 aborts the WebAssembly runtime; 4.14 is the generation that runs. The Razor
         compiler asks for 5.9 but binds against this by simple name on Mono, which is fine. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- The Razor compiler ships as a Roslyn source generator inside the SDK (there is no released
       standalone package), and the BCL + ASP.NET Core reference assemblies come from
       scripts/prepare-refs.ps1 into refs/. Neither is embedded here: embedded, they put ~16 MB into
       the app assembly, which the browser must download before the app can start. make-package.ps1
       packs them into refs.zip and razor.zip beside the app, and the app fetches them on first use
       (see Payload.cs).

       The Razor compiler is loaded from bytes rather than referenced: an assembly reference makes
       MSBuild resolve the compiler's own Roslyn 5.9 dependency from the SDK and publish it, which
       aborts the runtime. Loaded from bytes it uses the Roslyn already in the app (4.14). -->
</Project>
